 // magic constants for patching
-#define UPX_MAGIC_LE32  0x21585055 /* "UPX!" */
-#define UPX_MAGIC2_LE32 0xD5D0D8A1
+#define UPX_MAGIC_LE32  0xB6E4A291 /* RREA: non-text pack header tag. */
